# DevFix AI Platform — Environment Configuration Template
# Copy this file to .env for local deployment. Never commit actual secrets to source control.

# Server & Runtime Configuration
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
CORS_ORIGIN="*"

# AI & Provider Configuration
# Required for Gemini Multi-Agent calls (automatically injected by AI Studio when configured)
GEMINI_API_KEY=""

# Security & Authentication
JWT_SECRET="devfix_production_jwt_secret_change_in_production_minimum_32_chars"
JWT_EXPIRES_IN="7d"

# Rate Limiting (Requests per minute per IP / User)
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=15
RATE_LIMIT_AI=20
RATE_LIMIT_EXECUTION=30

# Sandboxed Execution & Safety Limits
MAX_CODE_SIZE_BYTES=65536
EXECUTION_TIMEOUT_MS=6000
MAX_OUTPUT_LENGTH_CHARS=10000

# Subsystem & Service Endpoints
MCP_SERVER_URL="http://localhost:3000/api/mcp"
TRANSFORMER_SERVICE_URL="http://localhost:3000/api/transformer"

# Database & Storage
DATABASE_PATH="./data/devfix.json"
